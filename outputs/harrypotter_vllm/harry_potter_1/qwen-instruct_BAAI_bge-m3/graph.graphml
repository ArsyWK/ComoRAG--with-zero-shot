      <data key="v_hash_id">chunk-3ab156a8614ab6077d2e4ab2792e7c22</data>
      <data key="v_content">I won&apos;t let you do it,&quot; he said, hurrying to stand in front of the
portrait hole.</data>
      <data key="v_name">chunk-3ab156a8614ab6077d2e4ab2792e7c22</data>
    </node>
    <node id="n4807">
      <data key="v_hash_id">chunk-8e851f571b344ea987f3e810ac9ba8eb</data>
      <data key="v_content">&quot;I&apos;ll -- I&apos;ll fight you!&quot;
&quot;Neville, &quot;Ron exploded, &quot;get away from that hole and don&apos;t be an idiot
--&quot;
&quot;Don&apos;t you call me an idiot!&quot; said Neville.</data>
      <data key="v_name">chunk-8e851f571b344ea987f3e810ac9ba8eb</data>
    </node>
