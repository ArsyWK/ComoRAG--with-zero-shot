      <data key="v_hash_id">chunk-6ac4f591d39a3ff3f1a6d1b46fe385a3</data>
      <data key="v_content">He pocketed it to use on Fluffy -- he didn&apos;t
feel much like singing.</data>
      <data key="v_name">chunk-6ac4f591d39a3ff3f1a6d1b46fe385a3</data>
    </node>
    <node id="n4796">
      <data key="v_hash_id">chunk-1880795e624fb9492df299c8179f9bd4</data>
      <data key="v_content">He ran back down to the common room.</data>
      <data key="v_name">chunk-1880795e624fb9492df299c8179f9bd4</data>
    </node>
    <node id="n4797">
      <data key="v_hash_id">chunk-d678fb00092e815fdb277e3e9d246fa5</data>
      <data key="v_content">&quot;We&apos;d better put the cloak on here, and make sure it covers all three of
us -- if Filch spots one of our feet wandering along on its own --&quot;
&quot;What are you doing?&quot; said a voice from the corner of the room.</data>
      <data key="v_name">chunk-d678fb00092e815fdb277e3e9d246fa5</data>
    </node>
