      <data key="v_content">Merekayangpertamamenjelaskan,Mereka yang pertama 
menjelaskan secara gamblang implikasi amar makruf nahi mungkar  
sebagai pegangan moral kami sepanjang hayat.</data>
      <data key="v_name">chunk-bee93fb91ea55e76560e52b44e4332da</data>
