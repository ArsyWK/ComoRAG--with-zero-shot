      <data key="v_content">Sebuahkarakterfabelyang,Sebuah karakter fabel yang menarik karena 
beberapa cerita rakyat memberikan definisi yang berbeda bagi 
makhluk mitos itu.</data>
      <data key="v_name">chunk-f2f4918d973db28222b14c308079ba96</data>
