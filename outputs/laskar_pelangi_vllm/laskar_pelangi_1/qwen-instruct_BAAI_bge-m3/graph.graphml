      <data key="v_hash_id">chunk-40ff9466bcb72f853754278fed0d68e6</data>
      <data key="v_content">Masyarakatlebihsukamenonton,Masyarakat lebih suka menonton 
di dekat podium daripada di pinggir -pinggir jalan, karena di podium 
para peserta diwajibkan beraksi, menunjukkan kelebihan, dan 
mempertontonkan atraksi andalannya sambil memberi 
penghormatan.</data>
      <data key="v_name">chunk-40ff9466bcb72f853754278fed0d68e6</data>
    </node>
