      <data key="v_content">Apalagitersiarkabarbahwa,Apalagi tersiar kabar bahwa Tuk tak menerima semua orang.</data>
      <data key="v_name">chunk-271e13bdcef92f9693582be11671e652</data>
    </node>
    <node id="n5133">
      <data key="v_hash_id">chunk-ad978886629f7f2a1240847485819789</data>
      <data key="v_content">Hanyanasibyangmenentukan,Hanya nasib yang menentukan apakah Tuk berkenan atau tidak.</data>
      <data key="v_name">chunk-ad978886629f7f2a1240847485819789</data>
