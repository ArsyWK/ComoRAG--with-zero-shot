      <data key="v_hash_id">chunk-38922b3cb359ad300670ce9cf128fe9a</data>
      <data key="v_content">Merekamempersiapkandiridengan,Mereka mempersiapkan diri dengan teliti dan 
mengerahkan seluruh sumber daya karena perjalanan ke Pulau 
Lanun tak mudah dan biayanya sangat mahal.</data>
      <data key="v_name">chunk-38922b3cb359ad300670ce9cf128fe9a</data>
    </node>
