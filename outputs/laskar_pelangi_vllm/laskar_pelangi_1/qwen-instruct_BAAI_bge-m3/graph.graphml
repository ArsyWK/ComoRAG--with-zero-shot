      <data key="v_content">Keinginankuatitujuga,Keinginan kuat itu juga 
memunculkan kemampuankemampuan besar yang tersembunyi dan 
keajaibankeajaiban di luar perkiraan.</data>
      <data key="v_name">chunk-d0ac508500a43c5ad6ff215acc8402dc</data>
    </node>
