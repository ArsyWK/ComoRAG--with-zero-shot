      <data key="v_content">Namunbagiparaanggota,Namun bagi para anggota Societeit, organisasi mereka adalah 
organisasi yang sangat serius.</data>
      <data key="v_name">chunk-8ad0f840010730cf4773a4220b3ad3a1</data>
    </node>
