      <data key="v_content">Merekalahmentor,penjaga,sahabat,,Merekalah mentor, penjaga, 
sahabat, pengajar, dan guru spiritual.</data>
      <data key="v_name">chunk-88702838e32a046de199c4d2bafcefbd</data>
    </node>
