      <data key="v_hash_id">chunk-7a8cacc60753d00340747dae9f516a44</data>
      <data key="v_content">“Makasayasenahkananak,“Maka saya senahkan anak saya pada Ibu, jika ia menyulitkan, 
Bapak Kepala Sekolah sudah tahu di mana harus menemui saya.</data>
      <data key="v_name">chunk-7a8cacc60753d00340747dae9f516a44</data>
    </node>
