      <data key="v_content">178LaskarPelangiTopinya,178  Laskar Pelangi 
 
   Topinya adalah baret putih yang diselipi selembar bulu angsa 
putih bersih seperti topi Robin Hood.</data>
      <data key="v_name">chunk-b4bdb727df6f631d2e783e935b889ab4</data>
    </node>
