      <data key="v_content">KunjungankePulauLanun,Kunjungan ke Pulau Lanun untuk menjumpai Tuk merupakan 
ekspedisi paling penting dan puncak seluruh aktivitas paranormal 
Societeit.</data>
      <data key="v_name">chunk-baf1a2bb6ed351f0c033c6fb69edb24f</data>
    </node>
