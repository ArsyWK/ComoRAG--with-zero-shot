      <data key="v_content">Teronggoksepisepertisebuah,Teronggok sepi seperti sebuah benda asing yang dikelilingi 
samudna, Pulau Lanun tampak kecil sekali.</data>
      <data key="v_name">chunk-d28d601a312dbf2681790769ad7c7b20</data>
    </node>
