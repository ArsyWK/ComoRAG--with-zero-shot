      <data key="v_hash_id">chunk-2b3529467bec821a90f45c0417bbcff3</data>
      <data key="v_content">Kamitakpernahsekali,Kami 
tak pernah sekali pun dengan sengaja menyatakan pembangkangan, 
kami bahkan memanggil  guru kami ibunda guru.</data>
      <data key="v_name">chunk-2b3529467bec821a90f45c0417bbcff3</data>
    </node>
