      <data key="v_content">Timahselalumengikatmaterial,Timah selalu 
mengikat material ikutan, yakni harta karun tak ternilai yang 
melimpah ruah: granit, zirkonium, silika, senotim, monazite, ilmenit, 
siderit, hematit, c lay, emas, galena, tembaga, kaolin, kuarsa , dan  
topas ….</data>
      <data key="v_name">chunk-80629d44b8fbcd1d30db1c938efc325d</data>
    </node>
