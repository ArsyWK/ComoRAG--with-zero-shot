      <data key="v_content">Karenaiaberpengalamandan,Karena ia 
berpengalaman dan tak mau mati konyol sebab ia tahu reputasi Tuk 
maka harga jasa nakhoda ini juga sangat mahal.</data>
      <data key="v_name">chunk-ea3f61c26da5c617e43e0867b436c780</data>
    </node>
