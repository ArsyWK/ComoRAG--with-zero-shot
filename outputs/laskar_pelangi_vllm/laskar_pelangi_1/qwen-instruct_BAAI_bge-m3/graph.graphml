      <data key="v_content">PNmerupakanpenghasiltimah,PN merupakan penghasil timah nasional terbesar yang 
mempekerjakan tak kurang dari 14.000 orang.</data>
      <data key="v_name">chunk-c36f636ddd28a31ce55cf1653a1e836d</data>
