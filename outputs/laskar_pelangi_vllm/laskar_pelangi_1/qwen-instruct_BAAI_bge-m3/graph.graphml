      <data key="v_name">chunk-ecb938770aecdef33d09539dc8b5efec</data>
    </node>
    <node id="n2885">
      <data key="v_hash_id">chunk-3d17246b865131b6f0561d33724132e3</data>
      <data key="v_content">Itulahkuburanyangkumaksud,Itulah kuburan yang kumaksud 
taid dalam perjan jian kami,  maka tibalah giliranku mengayuh 
sepeda.</data>
      <data key="v_name">chunk-3d17246b865131b6f0561d33724132e3</data>
    </node>
    <node id="n2886">
      <data key="v_hash_id">chunk-0572c6108335afe7e7d3af9441373ac9</data>
      <data key="v_content">Akunaikisepedaitu,Aku naiki sepeda itu tanpa selera, setengah hati, dan sejak 
gelindingan ro da yang pertama aku sudah memarahi diriku sen diri, 
menyesali tugas ini, toko busuk itu, dan pengaturan bodoh yang 
kami baut.</data>
      <data key="v_name">chunk-0572c6108335afe7e7d3af9441373ac9</data>
    </node>
