      <data key="v_hash_id">chunk-31c7b4f34d62b146b923b53eeb81ad20</data>
      <data key="v_content">Iasemacamorganisasi,Ia s emacam organisasi tanpa 
bentuk.</data>
      <data key="v_name">chunk-31c7b4f34d62b146b923b53eeb81ad20</data>
    </node>
    <node id="n4977">
      <data key="v_hash_id">chunk-223978ae7130d7c18b45be542547d036</data>
      <data key="v_content">Takdiketahuikapan,di,Tak diketahui kapan, di mana mereka biasa berkumpul, dan 
apa yang mereka bicarakan.</data>
      <data key="v_name">chunk-223978ae7130d7c18b45be542547d036</data>
    </node>
