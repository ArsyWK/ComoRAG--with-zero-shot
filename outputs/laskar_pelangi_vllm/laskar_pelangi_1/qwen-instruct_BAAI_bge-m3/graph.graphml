      <data key="v_content">Didalamhatiaku,Di dalam hati aku mencoba merekonstruksi perasaan yang 
dialami utusan pawang ang in tempo hari dan sejauh ini semuanya 
tepat.</data>
      <data key="v_name">chunk-69b67817691962134e49a7d623edd573</data>
    </node>
