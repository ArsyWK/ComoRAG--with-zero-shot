      <data key="v_content">Spandukitutergantungmenyedihkan,Spanduk itu tergantung menyedihkan di antara 
dua buah bambu kuning seadanya.</data>
      <data key="v_name">chunk-ee381c06ea4e08502a59141947ffca27</data>
    </node>
    <node id="n3130">
