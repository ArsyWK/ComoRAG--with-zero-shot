      <data key="v_content">Akuinginmelarikandiri,Aku ingin melarikan diri ke satu -satunya tempat yang paling indah 
dalam hidupku, yang telah kukenal sejak belasan tahun yang lalu.</data>
      <data key="v_name">chunk-817aca74aaf1b17e4ce73733bfb67a1a</data>
