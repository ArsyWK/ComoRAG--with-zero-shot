      <data key="v_content">Dibelakangnyaberbarispara,Di belakangnya berbaris para siswa yang memakai sarung, 
kopiah, dan baju takwa.</data>
      <data key="v_name">chunk-f6ea01c9efdc075ed0b511ab627b1cdc</data>
