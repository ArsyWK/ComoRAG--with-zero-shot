      <data key="v_content">Merekaadalahksatriatampa,Mereka adalah ksatria tampa pamrih, pangeran keikhl asan, 
dan sumur jernih ilmu pengetahuan di ladang yang ditinggalkan.</data>
      <data key="v_name">chunk-40291508d4b46bc004ff314fa38e38fd</data>
    </node>
