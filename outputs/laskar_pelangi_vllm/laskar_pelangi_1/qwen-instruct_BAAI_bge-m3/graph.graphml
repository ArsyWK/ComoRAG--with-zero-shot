      <data key="v_content">Bapak-nyajugamenatapanaknya,,Bapak -nya juga menatapanaknya, suatu 
tatapan penuh kekalahan yang pedih.</data>
      <data key="v_name">chunk-b43aba62cce004719a73a872be0fc2cf</data>
    </node>
