      <data key="v_content">MakaTuktakubahnya,Maka Tuk tak ubahnya Robin Hood, 
pahlawan yang mencuri untuk menolong kaum papa, atau orang 
yang berbuat baik dengan cara yang salah.</data>
      <data key="v_name">chunk-772b6078be01c54a362dac5d684a78c7</data>
    </node>
