      <data key="v_content">JikaAndaseorangdarwin,Jika Anda 
seorang darwin ian, silakan berperilaku seolah tak ada tuntutan 
akhirat, karena bagi Anda ktia bsuci yang memaktub bahwa 
manusia berasal dari Nabi Adam adalah dusta.</data>
      <data key="v_name">chunk-d9c47b66240f7184b318029a676e38e6</data>
    </node>
