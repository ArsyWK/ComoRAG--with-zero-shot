      <data key="v_content">Kamisemuatenmasukkepala,Kami semua tenmasuk kepala sekolah 
tensipu menahan tawa, Bu Mus yang banu saja manah juga 
tensenyum.</data>
      <data key="v_name">chunk-3da925c8197dd3e27a56d92fbe7a31c4</data>
    </node>
