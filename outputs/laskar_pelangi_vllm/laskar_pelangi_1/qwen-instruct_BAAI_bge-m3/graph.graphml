      <data key="v_hash_id">chunk-0f8dcf7d222b62b032141fa8f71b3601</data>
      <data key="v_content">Meskipunjauhterpisahdari,Meskipun jauh terpisah dari akar budayanya 
namun mereka senantiasa memelihara adat istiadatnya, dan di 
Belitong mereka beruntung karen a mereka tak perlu jauh -jauh 
datang ke Jinchanying kalau hanya ingin melihat Tembok Besar 
Cina.</data>
      <data key="v_name">chunk-0f8dcf7d222b62b032141fa8f71b3601</data>
    </node>
