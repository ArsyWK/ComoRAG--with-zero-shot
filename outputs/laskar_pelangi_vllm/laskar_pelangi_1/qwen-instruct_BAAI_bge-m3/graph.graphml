      <data key="v_content">Padabaqianinicahaya,Pada baqian ini cahaya bulan tak 
tembus dan terang hanya kami dapat dan lampu pelita kecil yang 
berayun-ayun di tiang layar.</data>
      <data key="v_name">chunk-7c35ddc1e33b97d9df207c0cecd166fc</data>
    </node>
