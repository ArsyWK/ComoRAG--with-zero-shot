      <data key="v_content">Misteriinimengandungdaya,Misteri 
ini mengandung daya tarik dunia bawah tanah, metafisika, 
paranormal, fenomena -fenomena janggal,  dan ilmu pengetahuan 
yang membakar rasa ingin tahu sebagian orang.</data>
      <data key="v_name">chunk-0ce9d86b73023d860a4d25ee70834ff5</data>
    </node>
