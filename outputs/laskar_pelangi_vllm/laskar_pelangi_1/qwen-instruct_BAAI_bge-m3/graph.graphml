      <data key="v_content">Sepertidugaannya,Tuhantelah,Seperti dugaannya, Tuhan telah memberinya pendamping secara 
misterius.</data>
      <data key="v_name">chunk-053cee604fdd518691ab59912194963a</data>
    </node>
