      <data key="v_hash_id">chunk-fdf9f9b5f7bcf348cb1d115b3f8a3771</data>
      <data key="v_content">Akujugatakkeberatan,Aku juga tak 
keberatan menjadi Mary Shelley yang hanya pernah sekali menulis 
buku Frankenstein lalu hilang dalam kejayaan.</data>
      <data key="v_name">chunk-fdf9f9b5f7bcf348cb1d115b3f8a3771</data>
    </node>
