      <data key="v_content">Kawanankerasampaimencapai,Kawanan kera sampai mencapai 
lima kelompok, saling berebutan lahan dengan serakah.</data>
      <data key="v_name">chunk-71116128be1dd236dc6b8271387f3888</data>
    </node>
