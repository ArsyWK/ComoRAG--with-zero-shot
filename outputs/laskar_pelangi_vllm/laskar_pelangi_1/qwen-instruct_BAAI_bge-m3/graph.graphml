      <data key="v_content">Iamenyeraphampirseluruh,Ia menyerap hampir 
seluruh angkatan kerja di Belitong dan  menghasilkan devisa jutaan 
dolar.</data>
      <data key="v_name">chunk-1407e12a384d239f04e5d24b7ea5e51e</data>
