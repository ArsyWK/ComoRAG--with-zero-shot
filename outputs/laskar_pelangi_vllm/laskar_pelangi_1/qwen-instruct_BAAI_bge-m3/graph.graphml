      <data key="v_hash_id">chunk-a9fd2c78412379eb0507e21c66411468</data>
      <data key="v_content">Namun,ternyatatemannyamasih,Namun, ternyata temannya masih meragu kannya dengan 
menggunakan kata “mungkin”, padahal tenda kami sudah hancur 
lebur diaduk -aduk badai.</data>
      <data key="v_name">chunk-a9fd2c78412379eb0507e21c66411468</data>
    </node>
