      <data key="v_content">Besoknyaakusudahbisa,Besoknya aku sudah bisa 
berangkat ke s ekolah dan aku tahu persis yang menyembuhkanku 
adalah pil APC.</data>
      <data key="v_name">chunk-0e3f5206053798afedb3f70b1db8aeb7</data>
    </node>
    <node id="n4416">
