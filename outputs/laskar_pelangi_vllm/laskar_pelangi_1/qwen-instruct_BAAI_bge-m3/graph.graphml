      <data key="v_hash_id">chunk-bce1d33ba8eda48d723f6459992fbaec</data>
      <data key="v_content">Sepertiguru-gurukami,,Seperti guru -guru kami, filicium 
memberi napas kehidupan bagi ribuan organise dan menjadi 
tonggak penting mata rantai ekosistem.</data>
      <data key="v_name">chunk-bce1d33ba8eda48d723f6459992fbaec</data>
