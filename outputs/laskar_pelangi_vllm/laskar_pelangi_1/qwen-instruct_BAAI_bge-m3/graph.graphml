      <data key="v_content">Kisahkesaktian,gayahidup,,Kisah kesaktian, gaya hidup, 
biografi, dan paradoks kepahlawanan Tuk ketika dikonfrontasikan 
dengan keyakinan orang awam akan menjadi sebuah misteri.</data>
      <data key="v_name">chunk-9addc38c517ae2841a4cdf202ae29b50</data>
    </node>
