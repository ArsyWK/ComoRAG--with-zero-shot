      <data key="v_hash_id">chunk-e8d12e18d1c3850cc1c29ad68422650c</data>
      <data key="v_content">Lalupilihanituseharusnya,Lalu pilihan itu seharusnya 
menentukan perilaku dalam menghargai hidup ini.</data>
      <data key="v_name">chunk-e8d12e18d1c3850cc1c29ad68422650c</data>
    </node>
