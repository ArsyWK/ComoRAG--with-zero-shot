      <data key="v_hash_id">chunk-e2a5546d297a3a9ed60be8a97cb82341</data>
      <data key="v_content">Akutersenyumsendiri65,Aku tersenyum sendiri 
65  Laskar Pelangi 
melamunkan seifat -sifat kawan sekelasku.</data>
      <data key="v_name">chunk-e2a5546d297a3a9ed60be8a97cb82341</data>
    </node>
