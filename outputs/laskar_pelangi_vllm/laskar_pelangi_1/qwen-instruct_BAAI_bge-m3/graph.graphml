      <data key="v_hash_id">chunk-e76a873cddc6ae19967f6f6edee74907</data>
      <data key="v_content">Laluakumemandangiguruku,Lalu aku memandangi 
guruku Bu Mus, seseorang yang bersedia menerima kami apa 
adanya dengan sepenuh hatinya, segenap jiwanya.</data>
      <data key="v_name">chunk-e76a873cddc6ae19967f6f6edee74907</data>
    </node>
