barisan panjang marching band membentuk fomrasi dua kali 
putaran jajarangenjang sambil memberi penghormatan di depan 
podium kehormatan.</data>
      <data key="v_name">chunk-3ac48e5b1aea64fb58e1ced7ccdcc58c</data>
    </node>
